# Build stage
FROM node:latest as build
WORKDIR /app

# Inlined into the SPA bundle by Vite at build time. The Azure pipeline
# passes these via --build-arg from the scanupload-qrcodegenerator-demo-env
# Variable Group so the demo always points at the correct hub/tenant per
# environment. Default values match `.env` — if the pipeline passes a
# build-arg it overrides the default, otherwise the bundled default is used.
ARG VITE_CLIENT_ID=442585d5-8625-4401-adff-8f00ef11e6d5.asante-it.scanupload.hub
ARG VITE_SESSION_URL=https://hub.scanupload.net/api/v2/front-end/session
ENV VITE_CLIENT_ID=$VITE_CLIENT_ID
ENV VITE_SESSION_URL=$VITE_SESSION_URL

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Serve with Nginx. We renamed nginx.conf.template -> nginx.conf and move
# it to /etc/nginx/conf.d/ so the nginx image's auto-envsubst script
# (20-envsubst-on-templates.sh, which only matches *.template) skips it.
# Our own docker-entrypoint.sh runs envsubst on the CSP vars at start.
FROM nginx:latest
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
