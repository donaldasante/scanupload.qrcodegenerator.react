# Shared local defaults for the React demo. Committed so a fresh clone works
# out of the box. Override any value with your own .env.local (gitignored).
VITE_SESSION_URL=/hub-api/api/v2/front-end/session
VITE_CLIENT_ID=661063cd-39c0-4562-b333-6479cb49b553.donalds-company.scanupload.hub
# Dev-only: Vite dev server proxies /hub-api/* to this target. Production
# uses the HUB_API_URL env var injected into nginx at container start.
VITE_HUB_API_TARGET_DEV=https://qa-hub.scanupload.net