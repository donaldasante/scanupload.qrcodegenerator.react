# Build stage
FROM node:latest as build
WORKDIR /app

# Inlined into the SPA bundle by Vite at build time. The Azure pipeline
# passes these via --build-arg from the scanupload-qrcodegenerator-demo-env
# Variable Group. When provided, the variable is exported so Vite picks it
# up (process.env always wins over .env). When not provided (empty), the
# export is skipped entirely, so Vite falls back to the `.env` file value.
ARG VITE_CLIENT_ID
ARG VITE_SESSION_URL

COPY package*.json ./
RUN npm install

COPY . .
RUN if [ -n "${VITE_CLIENT_ID}" ]; then export VITE_CLIENT_ID="${VITE_CLIENT_ID}"; fi && \
    if [ -n "${VITE_SESSION_URL}" ]; then export VITE_SESSION_URL="${VITE_SESSION_URL}"; fi && \
    npm run build

# Serve with Nginx. We renamed nginx.conf.template -> nginx.conf and move
# it to /etc/nginx/conf.d/ so the nginx image's auto-envsubst script
# (20-envsubst-on-templates.sh, which only matches *.template) skips it.
# Our own docker-entrypoint.sh runs envsubst on the CSP vars at start.
FROM nginx:latest
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
