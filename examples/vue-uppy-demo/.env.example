# Template for env vars read by Vite (https://vitejs.dev/guide/env-and-mode.html).
# Copy to .env and fill in real values, or copy to .env.local (gitignored) to
# override the shared defaults without committing them.
#
# Variables prefixed with `VITE_` are exposed to client code via
# `import.meta.env.VITE_<NAME>`. Anything else is server-only.
#
# Modes: `npm run dev` loads `.env` and `.env.local`. `npm run dev:qa` layers
# the committed `.env.qa` (the shared QA hub) on top, so any key `.env.qa` also
# defines is overridden — put personal values in `.env` and run plain
# `npm run dev`, or use `.env.qa.local` (gitignored) when running in QA mode.

# URL the browser POSTs to in order to create a ScanUpload session.
# The Origin header is sent automatically and is the only auth the hub needs.
VITE_SESSION_URL=https://hub.scanupload.net/api/v2/front-end/session

# Required tenant / Keycloak `client_id`. Sent in the request body as
# `{ "clientId": "..." }` so the hub can scope audit, rate-limits, and
# per-client rules.
VITE_CLIENT_ID=your-tenant-id

# Where Uppy sends the files it receives from the phone.
# Leave unset to use the built-in dev-server mock (`/demo-upload`), which just
# echoes the received byte count back as JSON.
# VITE_UPLOAD_ENDPOINT=https://your-backend.example.com/api/uploads
