# Browser-side variables exposed via `process.env.NEXT_PUBLIC_*`. The Next.js
# dev server only exposes variables prefixed with `NEXT_PUBLIC_` to client code.
# Copy this file to .env.local (gitignored) and fill in real values.

# URL the browser POSTs to in order to create a ScanUpload session.
# The Origin header is sent automatically and is the only auth the hub needs.
# This points directly at the hub — no client-side proxy is required.
NEXT_PUBLIC_SESSION_URL=https://localhost:8081/api/v2/front-end/session

# Tenant / Keycloak `client_id`. Sent in the request body as
# `{ "clientId": "..." }` so the hub can scope audit, rate-limits, and
# per-client rules. Optional — leave blank to omit.
NEXT_PUBLIC_CLIENT_ID=d8167900-03e4-4049-8c41-48ccf29cde1f.asante-it.scanupload.hub