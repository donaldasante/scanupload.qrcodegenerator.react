# Secret - obtain from https://app.scanupload.net (generate a client id and secret)
SCANUPLOAD_CLIENT_ID=your-client-id
SCANUPLOAD_CLIENT_SECRET=your-client-secret

# Non-secret ScanUpload configuration (defaults match the .NET reference example)
# Only set these if you need to override the defaults.
# SCANUPLOAD_FRONTEND_BASE_URL=https://hub.scanupload.net/api/front-end
# SCANUPLOAD_KEYCLOAK_URL=https://identity.scanupload.net
# SCANUPLOAD_KEYCLOAK_REALM=scanupload-hub
# SCANUPLOAD_KEYCLOAK_SCOPE=openid profile email scanupload.hub