# Secret - obtain from https://app.scanupload.net (generate a client id and secret)
SCANUPLOAD_CLIENT_ID=your-client-id
SCANUPLOAD_CLIENT_SECRET=your-client-secret

# Non-secret ScanUpload configuration (defaults match the .NET reference example)
# Only set these if you need to override the defaults.
# SCANUPLOAD_FRONTEND_BASE_URL=https://hub.scanupload.net/api/front-end
# SCANUPLOAD_KEYCLOAK_URL=https://identity.scanupload.net
# SCANUPLOAD_KEYCLOAK_REALM=scanupload-hub
# SCANUPLOAD_KEYCLOAK_SCOPE=openid profile email scanupload.hub

# Browser-side variables exposed via `process.env.NEXT_PUBLIC_*`. The Next.js
# dev server only exposes variables prefixed with `NEXT_PUBLIC_` to client code.
# Copy this file to .env.local (gitignored) and fill in real values.

# URL the browser POSTs to in order to create a ScanUpload session.
# The Origin header is sent automatically and is the only auth the hub needs.
NEXT_PUBLIC_SESSION_URL=https://localhost:8081/api/v2/front-end/session

# Tenant / Keycloak `client_id`. Sent in the request body as
# `{ "clientId": "..." }` so the hub can scope audit, rate-limits, and
# per-client rules. Optional — leave blank to omit.
NEXT_PUBLIC_CLIENT_ID=

# Endpoint that streams all uploaded files for a session as a ZIP archive.
# Hit as `GET <url>?session_id=<id>`; auth is enforced by the hub's
# `FrontEndSessionPolicy` (cookie + Origin). Optional — leave blank to hide
# the "Download" CTA.
NEXT_PUBLIC_DOWNLOAD_URL=https://localhost:8081/api/v2/front-end/session/download