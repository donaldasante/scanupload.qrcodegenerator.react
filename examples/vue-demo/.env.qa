# Shared local defaults for the Vue demo. Committed so a fresh clone works
# out of the box. Override any value with your own .env.local (gitignored).
VITE_SESSION_URL=https://qa-hub.scanupload.net/api/v2/front-end/session
VITE_CLIENT_ID=661063cd-39c0-4562-b333-6479cb49b553.donalds-company.scanupload.hub
# Direct connection: the browser POSTs to the QA hub and opens wss:// for
# SignalR. No nginx proxy. The QA hub must whitelist this origin for CORS.